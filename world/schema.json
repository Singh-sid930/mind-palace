{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mind Palace world schemas",
  "definitions": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 120 },
    "bodyText": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "longText": { "type": "string", "minLength": 1, "maxLength": 16000 },

    "exhibit": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/kebabId" },
        "type": { "enum": ["plaque", "tome", "portrait", "artifact", "diagram", "image", "stair"] },
        "title": { "$ref": "#/definitions/shortText" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "plaque" } } },
          "then": {
            "required": ["text"],
            "properties": {
              "text": { "$ref": "#/definitions/bodyText" },
              "prop": { "enum": ["pedestal", "lectern"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "tome" } } },
          "then": {
            "required": ["text"],
            "properties": { "text": { "$ref": "#/definitions/longText" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "portrait" } } },
          "then": {
            "required": ["text"],
            "properties": {
              "subtitle": { "$ref": "#/definitions/shortText" },
              "text": { "$ref": "#/definitions/longText" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "artifact" } } },
          "then": {
            "required": ["prop", "text"],
            "properties": {
              "prop": { "type": "string" },
              "text": { "$ref": "#/definitions/longText" },
              "scale": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "diagram" } } },
          "then": {
            "required": ["spec"],
            "properties": {
              "spec": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "caption": { "$ref": "#/definitions/bodyText" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": {
            "required": ["image"],
            "properties": {
              "image": { "type": "string", "minLength": 1, "maxLength": 200 },
              "caption": { "$ref": "#/definitions/bodyText" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "stair" } } },
          "then": {
            "required": ["to"],
            "properties": {
              "to": { "$ref": "#/definitions/kebabId" },
              "caption": { "$ref": "#/definitions/bodyText" }
            }
          }
        }
      ]
    },

    "room": {
      "type": "object",
      "required": ["id", "name", "wing", "size", "order", "exhibits"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/kebabId" },
        "name": { "$ref": "#/definitions/shortText" },
        "wing": {
          "oneOf": [{ "$ref": "#/definitions/kebabId" }, { "type": "null" }]
        },
        "size": { "enum": ["small", "medium", "grand"] },
        "palette": { "type": "string" },
        "order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/definitions/kebabId" },
          "maxItems": 8
        },
        "exhibits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/definitions/exhibit" }
        }
      }
    },

    "world": {
      "type": "object",
      "required": ["title", "hub", "wings"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/definitions/shortText" },
        "subtitle": { "$ref": "#/definitions/shortText" },
        "hub": { "$ref": "#/definitions/kebabId" },
        "levels": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "name", "hub"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/kebabId" },
              "name": { "$ref": "#/definitions/shortText" },
              "hub": { "$ref": "#/definitions/kebabId" },
              "tier": { "type": "integer", "minimum": -8, "maximum": 8 }
            }
          }
        },
        "wings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "name", "palette"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/kebabId" },
              "name": { "$ref": "#/definitions/shortText" },
              "palette": { "type": "string" },
              "level": { "$ref": "#/definitions/kebabId" }
            }
          }
        }
      }
    },

    "graph": {
      "type": "object",
      "required": ["concepts", "edges"],
      "additionalProperties": false,
      "properties": {
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "room", "summary"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/kebabId" },
              "name": { "$ref": "#/definitions/shortText" },
              "room": { "$ref": "#/definitions/kebabId" },
              "exhibit": { "$ref": "#/definitions/kebabId" },
              "summary": { "$ref": "#/definitions/bodyText" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "relation"],
            "additionalProperties": false,
            "properties": {
              "from": { "$ref": "#/definitions/kebabId" },
              "to": { "$ref": "#/definitions/kebabId" },
              "relation": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
